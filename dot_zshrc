# gh: use the account that matches the repo's SSH host alias (see ~/.ssh/config).
gh() {
  local host user
  host=$(git remote get-url origin 2>/dev/null)
  host=${${host#*@}%%:*}
  case $host in
    github.augment|github.selectx|github.selectexterminating) user=augmentws ;;
    github.claims-intel) user=petefc-ci ;;
  esac
  if [[ -n $user && -z $GH_TOKEN ]]; then
    GH_TOKEN=$(command gh auth token --user $user) command gh "$@"
  else
    command gh "$@"
  fi
}
